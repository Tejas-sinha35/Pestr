{
  "name": "pestr",
  "main": "index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Daily at 08:00 UTC. Only does anything once RESEND_API_KEY and FROM_EMAIL are set.
  "triggers": { "crons": ["0 8 * * *"] },
  "vars": { "FROM_EMAIL": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pestr",
      "database_id": "cc3f9397-a6fc-45b8-8538-cf4958445116"
    }
  ]
}
